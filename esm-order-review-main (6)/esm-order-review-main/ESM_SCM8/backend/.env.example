# Copy to backend/.env only for local production-like verification.
# Railway variables must be configured in the Railway dashboard, never committed.
APP_ENV=production
FRONTEND_ORIGIN=https://esm.example.com
DATABASE_URL=postgresql://user:password@host:5432/esm_scm
REDIS_URL=redis://default:password@host:6379/0
# Defaults to REDIS_URL when omitted. A dedicated URL may be used to isolate
# worker traffic. Keep concurrency at 1 unless worker memory is sized for more.
CELERY_BROKER_URL=redis://default:password@host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@host:6379/0
# Analysis records fail first; Celery gets five more minutes to persist/clean up.
CELERY_TASK_TIME_LIMIT_SECONDS=2100
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=30
CELERY_WORKER_CONCURRENCY=1
SCM_SEASON_ANALYSIS_TIMEOUT_SECONDS=1800
SCM_ORDER_LOGIC_V3_ANALYSIS_TIMEOUT_SECONDS=1800
SCM_ANALYSIS_WORKER_GRACE_SECONDS=60
SCM_ANALYSIS_JOB_STALE_SECONDS=2160
SCM_ANALYSIS_SLOT_TTL_SECONDS=2400
# General Worker: analysis / dedicated V3 Worker: order-v3
CELERY_WORKER_QUEUES=analysis
# Local-only fallback. Production parallelism comes from isolated Worker
# replicas; keep this at 1 on memory-constrained developer PCs.
SCM_V3_LOCAL_WORKER_CONCURRENCY=1
# Create a Sentry Python/FastAPI project and copy its DSN here. Keep the
# sampling rate low initially; request bodies, cookies, and identity are scrubbed.
SENTRY_DSN=https://publicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set this to the deployed Git commit or release version for source correlation.
SENTRY_RELEASE=

# S3-compatible storage: completed workbooks and support attachments persist
# here. Raw uploads remain short-lived local workspaces during Excel analysis.
OBJECT_STORAGE_BUCKET=esm-scm-production
OBJECT_STORAGE_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=esm-scm
OBJECT_STORAGE_PRESIGN_SECONDS=300
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# S3 lifecycle works in whole days. Outputs include download metadata.
OBJECT_STORAGE_OUTPUT_RETENTION_DAYS=1
OBJECT_STORAGE_SUPPORT_RETENTION_DAYS=90

# Must be the mounted Railway Volume path, not the container filesystem.
SCM_STORAGE_DIR=/data/esm-scm

# Leave empty when FastAPI is reached directly. When a reverse proxy forwards
# X-Forwarded-For, set only that proxy's CIDR(s), e.g. 10.0.0.0/8.
SCM_TRUSTED_PROXY_CIDRS=

# CMS 원천 데이터 예열. 근무시간(SCM_PRE_ANALYSIS_HOURS_KST)에 주기마다 분석
# 기본 구간을 미리 받아 캐시를 채운다. 기본값 false이므로 켜지 않으면 사용자의
# 기본값 분석이 매번 CMS를 처음부터 받아 50초대가 된다. start_backend.bat도
# 이 값을 켜지만, 배치를 우회해 uvicorn을 직접 띄우는 경우를 위해 .env에도 둔다.
SCM_PRE_ANALYSIS_ENABLED=true
SCM_PRE_ANALYSIS_INTERVAL_SECONDS=1500
SCM_PRE_ANALYSIS_HOURS_KST=8-20

# Long-history strategy: monthly chunks + include_total=false + page_size=5000.
# Bound nested month/page parallelism so concurrent users do not overload CMS.
SEASON_LONG_HISTORY_MONTH_WORKERS=2
SEASON_LONG_HISTORY_PAGE_WORKERS=3
SEASON_LONG_HISTORY_MAX_IN_FLIGHT=6

# V3 시즌팩터 월간 candidate 생성. 공식 CMS 월 마감일 확인 후에만 켠다.
# 검증 통과 candidate는 자동으로 active 전환되고 직전 active는 retired로 보존된다.
SCM_V3_SEASON_FACTOR_MONTHLY_ENABLED=false
SCM_V3_SEASON_FACTOR_MONTHLY_DAY=1
SCM_V3_SEASON_FACTOR_MONTHLY_HOUR_KST=03
SCM_V3_SEASON_FACTOR_CHECK_INTERVAL_SECONDS=900

# Generate each value with: python -m backend.scripts.generate_password_hash
AUTH_ADMINMASTER_PASSWORD_HASH=
AUTH_EU_MANAGER_PASSWORD_HASH=
AUTH_BM1_PASSWORD_HASH=
AUTH_BM2_PASSWORD_HASH=
AUTH_BM3_PASSWORD_HASH=
AUTH_HNB_TEAM_PASSWORD_HASH=
AUTH_IA_PASSWORD_HASH=
AUTH_MY_TEAM_PASSWORD_HASH=
AUTH_SALES_TEAM_PASSWORD_HASH=
AUTH_VN_TEAM_PASSWORD_HASH=
